<mjml>
  <mj-head>
    <mj-title>Reset Your Password - Spentiva</mj-title>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text font-size="14px" color="#334155" line-height="1.6" />
      <mj-section background-color="#ffffff" padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <!-- Header -->
    <mj-section
      background-color="#ffffff"
      padding="28px 24px 20px"
      border-bottom="2px solid #10b981"
    >
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#0f172a" letter-spacing="-0.3px">
          Spentiva
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main Content -->
    <mj-section background-color="#ffffff" padding="32px 28px">
      <mj-column>
        <mj-text font-size="15px" color="#475569" padding-bottom="16px">
          Hi {{ name }},
        </mj-text>

        <mj-text font-size="15px" color="#334155" line-height="1.7" padding-bottom="24px">
          We received a request to reset your password. Use the code below to reset your password.
          This code is valid for <strong>1 hour</strong>.
        </mj-text>

        <!-- OTP Code -->
        <mj-wrapper
          background-color="#f8fafc"
          padding="24px"
          border-radius="6px"
          border="1px solid #e2e8f0"
        >
          <mj-section background-color="transparent" padding="0">
            <mj-column>
              <mj-text
                font-size="11px"
                color="#64748b"
                font-weight="600"
                letter-spacing="0.8px"
                align="center"
                padding-bottom="8px"
              >
                YOUR RESET CODE
              </mj-text>
              <mj-text
                font-size="32px"
                font-weight="700"
                color="#0f172a"
                align="center"
                letter-spacing="6px"
              >
                {{ otp }}
              </mj-text>
            </mj-column>
          </mj-section>
        </mj-wrapper>

        <mj-text font-size="14px" color="#334155" padding="24px 0 12px 0">
          Or use this link to reset your password:
        </mj-text>

        <mj-button
          background-color="#10b981"
          color="#ffffff"
          font-size="14px"
          font-weight="600"
          border-radius="6px"
          padding="0 0 24px 0"
          inner-padding="12px 28px"
          href="{{ resetUrl }}"
        >
          Reset Password
        </mj-button>

        <mj-divider border-color="#e2e8f0" border-width="1px" padding="4px 0 20px 0" />

        <mj-text font-size="12px" color="#94a3b8" line-height="1.6">
          If you didn't request this, you can safely ignore this email. Your password will remain
          unchanged.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f8fafc" padding="20px 24px" border-top="1px solid #e2e8f0">
      <mj-column>
        <mj-text align="center" font-size="11px" color="#94a3b8">
          &copy; 2025 Spentiva &middot; Smart Expense Tracking
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
