<mjml>
  <mj-head>
    <mj-title>Welcome to Spentiva</mj-title>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text font-size="14px" color="#334155" line-height="1.6" />
      <mj-section background-color="#ffffff" padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <!-- Header -->
    <mj-section
      background-color="#ffffff"
      padding="28px 24px 20px"
      border-bottom="2px solid #10b981"
    >
      <mj-column width="50px">
        <mj-image src="https://spentiva.com/spentiva-logo.png" alt="Spentiva" width="40px" height="40px" padding="0" />
      </mj-column>
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#0f172a" letter-spacing="-0.3px" padding-top="6px">
          Spentiva
        </mj-text>
      </mj-column>
    </mj-section>
        <mj-text font-size="24px" font-weight="700" color="#0f172a" padding-bottom="8px">
          Welcome to Spentiva! &#127881;
        </mj-text>

        <mj-text font-size="15px" color="#475569" padding-bottom="16px">
          Hi {{ name }},
        </mj-text>

        <mj-text font-size="15px" color="#334155" line-height="1.7" padding-bottom="24px">
          Thank you for joining Spentiva! We're excited to have you on board. Spentiva helps you
          track expenses, manage budgets, and gain insights into your spending habits.
        </mj-text>

        <!-- Feature Highlights -->
        <mj-wrapper
          background-color="#f0fdf4"
          padding="20px 24px"
          border-radius="6px"
          border="1px solid #bbf7d0"
        >
          <mj-section background-color="transparent" padding="0">
            <mj-column>
              <mj-text
                font-size="14px"
                color="#166534"
                font-weight="600"
                padding-bottom="12px"
              >
                Here's what you can do:
              </mj-text>
              <mj-text font-size="13px" color="#15803d" line-height="2">
                &#10003; Create expense trackers for different purposes<br />
                &#10003; Add and categorize your expenses easily<br />
                &#10003; View detailed analytics and reports<br />
                &#10003; Share trackers with family or team members<br />
                &#10003; Get scheduled reports delivered to your inbox
              </mj-text>
            </mj-column>
          </mj-section>
        </mj-wrapper>

        <mj-text font-size="15px" color="#334155" line-height="1.7" padding="24px 0">
          Get started by creating your first tracker. You can do it from the app or the web
          dashboard.
        </mj-text>

        <mj-button
          background-color="#10b981"
          color="#ffffff"
          font-size="14px"
          font-weight="600"
          border-radius="6px"
          padding="0"
          inner-padding="12px 28px"
          href="{{ appUrl }}"
        >
          Get Started
        </mj-button>

        <mj-divider border-color="#e2e8f0" border-width="1px" padding="28px 0 20px 0" />

        <mj-text font-size="12px" color="#94a3b8" line-height="1.6">
          If you didn't create this account, please ignore this email or contact us at
          support@spentiva.com
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f8fafc" padding="20px 24px" border-top="1px solid #e2e8f0">
      <mj-column>
        <mj-text align="center" font-size="11px" color="#94a3b8">
          &copy; 2025 Spentiva &middot; Smart Expense Tracking
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
